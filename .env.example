# Copier ce fichier en .env et adapter les valeurs. Le fichier .env n'est jamais commité.

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=campus_events
MYSQL_USER=campus
MYSQL_PASSWORD=campus

# Backend
JWT_SECRET=change-me

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Ports exposés sur la machine hôte
DB_PORT=3360
BACKEND_PORT=3000
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
